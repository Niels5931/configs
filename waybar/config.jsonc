{
    "layer": "top",
    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["network", "pulseaudio", "cpu", "battery"],
    "reload_style_on_change": true,

  "hyprland/workspaces": {
        "on-clock": "activate",
        "format": "{icon}",
        "format-icons": {
            "1": "<span foreground='#bf616a'>一</span>",
            "2": "<span foreground='#d08770'>二</span>",
            "3": "<span foreground='#ebcb8b'>三</span>",
            "4": "<span foreground='#a3be8c'>四</span>",
            "5": "<span foreground='#88c0d0'>五</span>",
            "6": "<span foreground='#81a1c1'>六</span>",
            "7": "<span foreground='#b48ead'>七</span>",
            "8": "<span foreground='#5e81ac'>八</span>"
        },
        "persistent-workspaces": {
        "1": [],
        "2": [],
        "3": [],
        "4": [],
        "5": [],
        "6": [],
      }
  },
  "clock": {
      "format": "󰥔\u00a0\u00a0{:%H:%M - %A, %B %d}",
      "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
  },
  "network": {
      "format-wifi": "<span foreground='#81a1c1'>󰤨</span>",
      "format-disconnected": "<span foreground='#81a1c1'>󰤭</span>",
      "on-click": "alacritty --class float-impala -e impala"
  },
  "pulseaudio": {
      "format": "<span foreground='#88c0d0'>{icon}</span>\u00a0\u00a0{volume}%",
      "format-muted": "<span foreground='#88c0d0'>󰖁</span>\u00a0\u00a0Muted",
      "format-icons": {
          "default": ["󰕿", "󰖀", "󰕾"]
      },
      "on-click": "pavucontrol"
  },
  "cpu": {
  	"interval": 1,
  	"format": "<span foreground='#bf616a'>{icon0}</span><span foreground='#d08770'>{icon1}</span><span foreground='#ebcb8b'>{icon2}</span><span foreground='#a3be8c'>{icon3}</span><span foreground='#81a1c1'>{icon4}</span><span foreground='#b48ead'>{icon5}</span>\u00a0{usage:>2}%\u00a0",
  	"format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"],
    "on-click": "alacritty --class float-btop -e btop",
  },
  "battery": {
      "states": {
          "good": 80,
          "warning": 30,
          "critical": 15
      },
      "format": "{icon} {capacity}%",
      "format-icons": {
        "default" : [
        "󰁺",
        "󰁻",
        "󰁼",
        "󰁽",
        "󰁾",
        "󰁿",
        "󰂀",
        "󰂁",
        "󰂂",
        "󰁹"
      ]},
      "format-charging": "{icon} {capacity}%",
      "format-plugged": "{icon} {capacity}%"
  }
}
